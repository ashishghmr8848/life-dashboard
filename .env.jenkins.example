# Copy to .env.jenkins (gitignored) and fill in.
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=change-me
# A GitHub personal access token with at least read access to this repo -
# used only for Jenkins' own git checkout, stored only in the jenkins_home
# Docker volume on your machine.
GITHUB_USERNAME=your-github-username
GITHUB_TOKEN=ghp_xxx
# Render API key (Account Settings) + owner id (same page, tea-.../usr-...) -
# lets Jenkins auto-create the render-api-key/render-owner-id credentials so
# PROVISION_RENDER builds work without a manual step under Manage Jenkins.
RENDER_API_KEY=rnd_xxx
RENDER_OWNER_ID=tea-xxx
# Real JWT signing secret for the deployed backend - generate with:
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
LIFE_DASHBOARD_JWT_SECRET=change-me
